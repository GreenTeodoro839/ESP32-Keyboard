# Test bench parameters. Copy to tests/testbed.env and adjust. Read by tools/ and tests/.
ESPKB_SERIAL_PORT=/dev/serial/by-id/<your-uart-adapter>
ESPKB_USB_VID=303a
ESPKB_USB_PID=4004
# Dedicated test hotspot (a NetworkManager connection in AP/shared mode) the device joins.
ESPKB_TEST_SSID=ESPKB-TEST
ESPKB_TEST_PSK=<hotspot-password>
ESPKB_NM_CONN=espkb-test
ESPKB_NM_IFACE=<wifi-interface>
ESPKB_HOTSPOT_GW=10.42.77.1
