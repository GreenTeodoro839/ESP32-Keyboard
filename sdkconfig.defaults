# ============================================================
# ESPKB - ESP32-S3 N16R8 defaults
# These are defaults only: an existing sdkconfig.<env> (generated, git-ignored)
# wins over them. After changing this file delete sdkconfig.esp32-s3-devkitc-1
# and build again.
# ============================================================

# ---------- Flash: 16 MB QIO ----------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---------- Partition table ----------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------- OTA (firmware update over WiFi) ----------
# partitions.csv has two app slots. A freshly updated image has to be confirmed
# by the app (src/ota.c) after its first boot; if it crashes or cannot bring up
# the network before that, the bootloader returns to the previous image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---------- PSRAM: 8 MB octal ----------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_IGNORE_NOTFOUND=n

# ---------- System ----------
# 1 ms tick: key/mouse delays are specified in milliseconds.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---------- USB (TinyUSB device, 3 HID interfaces: keyboard, mouse, absolute mouse) ----------
CONFIG_TINYUSB_HID_COUNT=3
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
CONFIG_TINYUSB_DEBUG_LEVEL=0

# ---------- HTTP server / WebSocket ----------
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ENABLE_EVENTS=n
CONFIG_HTTPD_PURGE_BUF_LEN=256

# ---------- lwIP: room for many short-lived clients ----------
# TIME_WAIT lasts 2*TCP_MSL. The WebSocket close path now waits for the
# client's FIN first (src/ws.c), but any remaining device-initiated close
# should not block a reused client port for the default 120 s. 5 s is ample
# for a LAN, where delayed duplicates live for milliseconds.
CONFIG_LWIP_TCP_MSL=5000
# 4 extra sockets let the WebSocket reaper wait for a client FIN without
# stealing a connection slot from the HTTP server (28 + 3 internal + 4 + 1 spare).
CONFIG_LWIP_MAX_SOCKETS=36
CONFIG_LWIP_MAX_ACTIVE_TCP=40
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# ---------- cJSON: bound recursion depth (stack safety) ----------
CONFIG_CJSON_NESTING_LIMIT=40
